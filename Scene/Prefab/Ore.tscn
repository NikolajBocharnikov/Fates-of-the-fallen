[sub_resource type="GDScript" id="GDScript_gioqm"]
resource_name = "Ore_init_script"
script/source = "@tool
extends Node3D

@export_enum(\"Iron\",\"Obsidian\",\"Blue\",\"Green\",\"Red\") var TYPE:String = \"Iron\"

@export var ORE_TYPE:Array[String] = [\"Iron\",\"Obsidian\",\"Blue\",\"Green\",\"Red\"] #0,1,2,3,4 ....
@export var RANDOM:bool = false

@onready var rotate_point: Node3D = $Rotate_point
@onready var target_pos: MeshInstance3D = $Rotate_point/Target_pos
@onready var control: Control = $Control
@onready var static_body_node: StaticBody3D = $StaticBody3D

var camera:Camera3D
var selected_ore:String = \"Iron\"

func _ready() -> void:
	control.visible = false
	camera = get_tree().get_first_node_in_group(\"Camera\")
	
	#print(TYPE)
	
	if !RANDOM:
		for i in ORE_TYPE.size():
			#print(i)
			if TYPE == ORE_TYPE[i]:
				static_body_node.get_child(i).visible = true
			else:
				static_body_node.get_child(i).visible = false
	elif RANDOM:
		var rand = randi_range(0,ORE_TYPE.size() - 1)
		selected_ore = ORE_TYPE[rand]
		#print(selected_ore)
		
		for i in ORE_TYPE.size():
			#print(i)
			if selected_ore == ORE_TYPE[i]:
				static_body_node.get_child(i).visible = true
			else:
				static_body_node.get_child(i).visible = false
	else:
		for i in ORE_TYPE.size() - 1:
			static_body_node.get_child(i).visible = false
		static_body_node.get_child(0).visible = true

@warning_ignore(\"unused_parameter\")
func _process(delta: float) -> void:
	if camera != null:
		control.global_position = camera.unproject_position(global_position)

func look_at_player(player:Node3D):
	rotate_point.look_at(player.global_position)

func ore_pick_up():
	$GPUParticles3D.restart()
	await $GPUParticles3D.finished
	
	match selected_ore:
		\"Iron\":
			GData.GAME_DATA[\"Ingot\"] += 1
		\"Obsidian\":
			GData.GAME_DATA[\"Obsidian\"] += 1
		\"Blue\":
			GData.GAME_DATA[\"Crystal\"] += 1
		\"Green\":
			GData.GAME_DATA[\"Crystal\"] += 1
		\"Red\":
			GData.GAME_DATA[\"Crystal\"] += 1
	
	queue_free()

func _on_activation_area_body_entered(body: Node3D) -> void:
	if body is CharacterBody3D:
		control.visible = true

func _on_activation_area_body_exited(body: Node3D) -> void:
	if body is CharacterBody3D:
		control.visible = false

func _on_button_pressed() -> void:
	ore_pick_up()
"

