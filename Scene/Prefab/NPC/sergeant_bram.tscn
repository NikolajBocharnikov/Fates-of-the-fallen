[sub_resource type="GDScript" id="GDScript_iwpab"]
script/source = "extends Node3D

@onready var rotate_point: Node3D = $Rotate_point
@onready var target_pos: MeshInstance3D = $Rotate_point/Target_pos
@onready var control: Control = $Control
@onready var shop_panel: Panel = $Shop_Panel
@onready var label: Label = $Label

@export var Player_Meele_Weapon_Selector:Node = null
@export var Meele_Weapon = [\"Purple_Ice\"]

var camera:Camera3D

func _ready() -> void:
	control.visible = false
	camera = get_tree().get_first_node_in_group(\"Camera\")
	for i in Meele_Weapon.size():
		$Shop_Panel/ItemList.add_item(Meele_Weapon[i])

@warning_ignore(\"unused_parameter\")
func _process(delta: float) -> void:
	if camera != null:
		control.global_position = camera.unproject_position(global_position)

func look_at_player(player:Node3D):
	rotate_point.look_at(player.global_position)

func _on_item_list_item_activated(index: int) -> void:
	#print($Shop_Panel/ItemList.get_item_text(index))
	if Player_Meele_Weapon_Selector != null:
		if Meele_Weapon != null:
			Player_Meele_Weapon_Selector.unlock_weapon(Meele_Weapon[index])
			$Shop_Panel/ItemList.remove_item(index)
			Meele_Weapon.erase(Meele_Weapon[index])
			#print(Meele_Weapon[index])
	#print(index)

@warning_ignore(\"unused_parameter\")
func _on_item_list_item_clicked(index: int, at_position: Vector2, mouse_button_index: int) -> void:
	label.position = shop_panel.global_position + at_position + Vector2(0,32)
	#print(shop_panel.global_position + at_position)
	#print(get_viewport().get_mouse_position()) #Useless 
	if Meele_Weapon != null:
		label.text = Meele_Weapon[index]

#Activation Area
func _on_activation_area_body_entered(body: Node3D) -> void:
	if body is CharacterBody3D:
		control.visible = true

func _on_activation_area_body_exited(body: Node3D) -> void:
	if body is CharacterBody3D:
		control.visible = false
		shop_panel.visible = false
		label.text = \" \"

#Controle Btn
func _on_button_pressed() -> void:
	shop_panel.visible = !shop_panel.visible
	label.visible = shop_panel.visible
"

